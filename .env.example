# Copy this file to .env and fill in real values. Never commit .env.

# BtcTurk API Access page: grant ONLY "Trade" permission, keep "Withdrawal" OFF.
BTCTURK_API_KEY=
BTCTURK_API_SECRET=

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: adds general news headlines to the LLM prompt. Skipped if empty.
CRYPTOPANIC_API_KEY=

# Optional: email notifications via Resend (https://resend.com). Skipped if empty.
RESEND_API_KEY=
NOTIFY_EMAIL=

# true = no real orders are placed, only logs what it would do.
DRY_RUN=true

# Total TRY capital the bot is allowed to risk (small, disposable amount).
MAX_CAPITAL_TRY=500

# --- Optional tuning (sane defaults are used if left unset) ---
# POSITION_SIZE_PCT=0.40
# MIN_CASH_BUFFER_PCT=0.15
# MIN_TRADE_TRY=150
# DAILY_LOSS_BASE_TRY=500
# BTCTURK_COMMISSION_RATE=0.0024
# REPORT_DAYS=2
